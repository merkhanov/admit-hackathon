{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)", "Bash(npm run typecheck)", "Bash(npm run lint)",
      "Bash(npm run campaign:seed)", "Bash(npm run geo:report)",
      "Bash(node scripts/queue-status*)", "Bash(npx tsx scripts/*--dry-run*)"
    ],
    "ask": [
